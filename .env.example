# Base de datos. Vacío = SQLite en api/chinkana.db (desarrollo).
# PostgreSQL: postgresql+psycopg://chinkana:dev123@localhost:5432/chinkana_dev
DATABASE_URL=

# Local (multi-local desde el día uno)
LOCAL_ID=1

# Clave para firmar las sesiones del admin. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Primer usuario del admin (solo se crea si no existe). Sin ADMIN_PASS se genera una y sale en el log.
ADMIN_USER=admin
ADMIN_PASS=

# Orígenes permitidos en desarrollo (front de Next.js en el puerto 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Carta desde admintienda (el POS es donde se crean productos, precios y disponibilidad).
# Vacío = la carta se edita a mano en /admin.
#   URL: base de la API de admintienda, con /api/v1 (ej. https://<tu-api>/api/v1)
#   KEY: se crea en admintienda → Ajustes → Integraciones (un superadmin debe habilitar la API del negocio)
#   SUCURSAL: id de la sucursal de este local (para el stock); vacío = suma de todas
ADMINTIENDA_URL=
ADMINTIENDA_API_KEY=
ADMINTIENDA_SUCURSAL=
