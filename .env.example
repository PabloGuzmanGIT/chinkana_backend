# Base de datos. Vacío = SQLite en api/chinkana.db (desarrollo).
# PostgreSQL: postgresql+psycopg://chinkana:dev123@localhost:5432/chinkana_dev
DATABASE_URL=

# Local (multi-local desde el día uno)
LOCAL_ID=1

# Clave para firmar las sesiones del admin. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Primer usuario del admin (solo se crea si no existe)
ADMIN_USER=admin
ADMIN_PASS=chinkana123

# Orígenes permitidos en desarrollo (front de Next.js en el puerto 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
